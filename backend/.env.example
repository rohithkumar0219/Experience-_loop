# Project Settings
PROJECT_NAME="ExperienceLoop API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL required)
# Format: postgresql+psycopg2://username:password@hostname:5432/database_name
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/experienceloop"

# Security & JWT
SECRET_KEY="experienceloop-super-secure-production-ready-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8000"]'

# Storage Configuration (local or s3)
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./uploads"
# S3 / MinIO Configuration (optional)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="experienceloop-files"
S3_REGION="us-east-1"

# AI Integration (Gemini / Generative AI)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
